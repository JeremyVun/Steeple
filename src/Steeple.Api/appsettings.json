{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Identity (CONTRACTS §4). Jwt:SigningKey is supplied per-environment (dev json / env var) so
  // no signing material ships in source-of-truth config; without it the API fails to start.
  // Provider ClientIds are the accepted `aud` values (web client id + mobile ids as they land);
  // empty lists reject that provider's tokens — fail closed until configured.
  "Auth": {
    "Jwt": {
      "Issuer": "steeple-api",
      "Audience": "steeple",
      "AccessTokenMinutes": 15
    },
    "RefreshTokenDays": 90,
    "Google": { "Mode": "", "ClientIds": [] },
    "Apple": { "Mode": "", "ClientIds": [] }
  },
  // Production must explicitly choose enabled/disabled; Development may omit Mode and infer from
  // the secret for compatibility with local provider testing.
  "Turnstile": { "Mode": "", "SecretKey": "" },
  // Transactional email (Resend adapter behind IEmailGateway). Production requires resend mode;
  // disabled Development mode still writes the inbox row and logs no recipient/content. Deployment
  // supplies Email__ApiKey / Email__From / Email__WebBaseUrl (absolute links in email bodies) —
  // the full setup procedure is docs/runbooks/email.md. DevMailboxEnabled is deliberately absent:
  // the dev mailbox exists only where appsettings.Development.json turns it on.
  "Email": {
    "Mode": "",
    "ApiKey": "",
    "From": "Steeple <onboarding@resend.dev>",
    "WebBaseUrl": ""
  },
  // Durable notification delivery. The dispatcher atomically enqueues email/push alongside the
  // inbox row; the worker leases bounded batches and retries provider failures with backoff.
  "NotificationOutbox": {
    "Enabled": true,
    "Interval": "00:00:05",
    "BatchSize": 50,
    "MaxAttempts": 5,
    "BaseRetryDelay": "00:00:30",
    "MaxRetryDelay": "01:00:00",
    "ClaimLease": "00:02:00"
  },
  // Bounded deletion of expired operational/private data. Legal acceptances and financial rows
  // are permanent; correspondence cleanup redacts text without deleting the booking graph.
  "DataRetention": {
    "Enabled": true,
    "Interval": "1.00:00:00",
    "BatchSize": 500,
    "RefreshTokenRetention": "30.00:00:00",
    "NotificationRetention": "365.00:00:00",
    "IdempotencyRetention": "30.00:00:00",
    "CorrespondenceRetention": "730.00:00:00",
    "NotificationOutboxRetention": "30.00:00:00"
  },
  // Upcoming-booking reminder sweep: "coming up" 7 days before a booking's first upcoming
  // occurrence, "tomorrow" 24 hours before every one. Enabled=false stops the background loop
  // without changing anything else.
  "Reminders": {
    "Enabled": true,
    "Interval": "00:15:00",
    "ComingUpLeadTime": "7.00:00:00",
    "TomorrowLeadTime": "1.00:00:00"
  },
  // FCM push (behind IPushGateway). Production names fcm or disabled mode; FCM receives one
  // credential via Push__ServiceAccountJson (preferred) or Push__ServiceAccountJsonPath.
  "Push": {
    "Mode": "",
    "ServiceAccountJsonPath": "",
    "ServiceAccountJson": ""
  },
  // Client flags proxy (CONTRACTS §8): explicit public allowlist only (mobile.apply_enabled,
  // mobile.manage_enabled, mobile.force_upgrade) — fail closed like Web's Flags section. 0 =
  // MobileMinSupportedBuild never forces an upgrade.
  "Flags": {
    "mobile.apply_enabled": false,
    "mobile.manage_enabled": false,
    // Operational gate: set false to auto-publish even a new host's first listing.
    "manage.first_listing_review_required": true,
    // Server-side gate (not a public client flag): require open hours before a room can publish.
    "manage.open_hours_required": false,
    // Server-side gate: guest availability reads + the submit-time schedule hard block (CONTRACTS §6).
    "listing.availability": false,
    // Host counter-offers on applications (CONTRACTS §5) — off in prod until the surface ships.
    "booking.counter_offers": false,
    // Server-side gate for the payments rails (docs/contracts/payments.md): the apply-time
    // payment-method gate, instant-book confirmation, price snapshots, and charging. Off = the
    // pre-payments request→approve loop, unchanged; flips on with the mock/Stripe rollout.
    "payments.enabled": false,
    "MobileMinSupportedBuild": 0
  },
  // Payments tuning (docs/contracts/payments.md). The behavioral switch is the payments.enabled
  // flag above; these are the sweeper/charge-window knobs (test suites shrink the intervals).
  "Payments": {
    "Gateway": "mock",
    "PublishableKey": "pk_mock_steeple",
    "SweepIntervalSeconds": 300,
    "RetryIntervalSeconds": 3600,
    "ChargeWindowHours": 48,
    "CancelDeadlineHours": 24
  },
  // Connection string is supplied per-environment: appsettings.Development.json for the local
  // `dotnet run` loop, ConnectionStrings__SteepleDb env var in Docker. Kept out of the base
  // (image-baked) file so no credential ships in source/the image and Production fails closed.
  // Geocoding (Manage module, provider address entry only — a metered SKU that must never sit
  // on a public hot path). Production selects apple/google explicitly; Development may infer.
  "Geocoding": {
    "Mode": "",
    "AppleTeamId": "",
    "AppleKeyId": "",
    "ApplePrivateKey": "",
    "Region": "",
    "LimitToCountries": ""
  },
  // Media storage (SYSTEM_DESIGN §9). Production selects objectStorage explicitly; Development
  // may infer it from complete settings or use local disk served by the API at /media.
  "Media": {
    "Mode": "",
    "ServiceUrl": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "PublicBaseUrl": "",
    "LocalRoot": "media-store"
  },
  // The canonical public origin (scheme + host + optional stripped prefix) every crawler-facing
  // absolute URL is built from: sitemap locs, listing canonicals, og:url, document <base>
  // (docs/contracts/seo.md, Public base and sub-path deployment). Deployment-supplied via
  // Seo__PublicBaseUrl; empty is a
  // Development convenience that falls back to the request's own origin and logs a warning
  // anywhere else. Forwarded headers deliberately never reach these URLs.
  "Seo": {
    "PublicBaseUrl": ""
  },
  "Geofence": {
    "AreaName": "Washington metropolitan area",
    "MinLatitude": 38.30,
    "MaxLatitude": 39.55,
    "MinLongitude": -78.25,
    "MaxLongitude": -76.35,
    "CenterLatitude": 38.9072,
    "CenterLongitude": -77.0369,
    "Timezone": "America/New_York"
  }
}
