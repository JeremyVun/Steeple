@model InboxViewModel

<section class="inbox-page wrap">
    <header class="inbox-head">
        <h1>Your requests</h1>
        @if (Model.IsProvider)
        {
            <a class="head-crosslink" href="~/manage/applications">
                Requests for your spaces
                @if (Model.HostPendingCount > 0)
                {
                    <span class="head-crosslink-count">@Model.HostPendingCount waiting</span>
                }
                →
            </a>
        }
    </header>

    <partial name="_ApplicationList" model="Model" />
</section>
