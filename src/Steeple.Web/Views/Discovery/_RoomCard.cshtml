@model RoomSummaryDto
@{
    // Carry the active search intent through to apply: a booking-shaped slot (band ∩ matched
    // window, searched duration long — never the room's whole open window), weekdays for weekly
    // searches, and the searched head-count.
    var whenQuery = ViewData["WhenQuery"] as ListingSearchQuery;
    var win = Model.MatchedWindow;
    var weekly = whenQuery?.IsWeekly == true;
    var carryDate = weekly ? (DateOnly?)null : (win?.Date ?? whenQuery?.Date);
    var (carryStart, carryEnd) = WhenCarry.ResolveCarryTimes(win, whenQuery);
    var whenSuffix = WhenCarry.ToQueryString(
        carryDate, carryStart, carryEnd, weekly ? whenQuery?.DaysOfWeek : null, whenQuery?.MinCapacity);
    var url = Url.Content($"~/space/{Model.VenueSlug}/{Model.RoomSlug}") + whenSuffix;
    string? distanceLabel = null;
    if (Model.DistanceMeters is double m)
    {
        distanceLabel = m < 1000
            ? $"{Math.Round(m)} m away"
            : $"{(m / 1000.0):0.#} km away";
    }
}

<a class="card" href="@url">
    <div class="card-photo">
        @if (!string.IsNullOrEmpty(Model.PrimaryPhotoUrl))
        {
            <img src="@Model.PrimaryPhotoUrl" width="1200" height="800" loading="lazy" decoding="async"
                 alt="@Model.RoomName at @Model.VenueName" />
        }
        else
        {
            <div class="card-photo-placeholder" aria-hidden="true">
                <span>@(string.IsNullOrEmpty(Model.RoomName) ? "?" : Model.RoomName.Substring(0, 1))</span>
            </div>
        }

        <span class="badge badge-price">$@Model.PricePerHour.ToString("0.##")/hr</span>
    </div>

    <div class="card-body">
        <h3 class="card-title">@Model.RoomName</h3>
        <p class="card-venue">@Model.VenueName</p>
        @if (Model.Rating is { } rating)
        {
            <p class="card-rating" aria-label="@BookingDisplay.RatingAverage(rating.AverageStars) out of 5 stars from @rating.Count ratings">
                <span aria-hidden="true">★</span> @BookingDisplay.RatingAverage(rating.AverageStars) (@rating.Count)
            </p>
        }

        <p class="card-meta">
            <span class="card-capacity">Up to @Model.Capacity</span>
            @if (distanceLabel is not null)
            {
                <span class="card-distance">· @distanceLabel</span>
            }
            @* Decision-critical practical facts, visible without opening the room (2026-07 study:
               both find-space personas opened detail pages solely to check parking). *@
            @if (Model.Amenities.Contains("parking"))
            {
                <span class="card-keyfact">· Parking</span>
            }
            @if (Model.Accessibility.Contains("stepFreeAccess"))
            {
                <span class="card-keyfact">· Step-free</span>
            }
        </p>

        @if (win is not null)
        {
            <p class="card-open">
                Open @ApplicationDisplay.FormatTimeRange(win.StartTime, win.EndTime)@(win.Date is { } wd ? $" on {wd:MMM d}" : "")
            </p>
        }

        @if (Model.Activities.Count > 0)
        {
            <ul class="chip-list" role="list">
                @foreach (var a in Model.Activities.Take(3))
                {
                    <li class="chip-static">@DiscoveryViewModel.Humanize(a)</li>
                }
                @if (Model.Activities.Count > 3)
                {
                    <li class="chip-static chip-more">+@(Model.Activities.Count - 3)</li>
                }
            </ul>
        }
    </div>
</a>
