@model Steeple.Admin.ViewModels.Admin.AdminWorkspaceViewModel
@{
    var listingsError = ViewData["ListingsError"] as string;
}

@* Takedown only. Hosts control their own publish/unlist after their first approval; this exists
   for abuse and DMCA (SYSTEM_DESIGN §14). Anything beyond it is a psql runbook, not a screen. *@
<div id="admin-listings-panel" class="admin-stack">
    @if (listingsError is not null)
    {
        <p class="admin-error" role="alert">@listingsError</p>
    }

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Listing</th>
                    <th>Area</th>
                    <th>Price</th>
                    <th>Queue</th>
                    <th>Status</th>
                    <th><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var listing in Model.Listings)
            {
                <tr>
                    <td>
                        <strong>@listing.Venue</strong>
                        <span>@listing.Room</span>
                    </td>
                    <td>@listing.Suburb</td>
                    <td>@listing.Price</td>
                    <td>@listing.PendingApplications pending · @listing.ActiveBookings booked</td>
                    <td><span class="admin-status">@listing.Status</span></td>
                    <td>
                        @if (listing.Status == "Published")
                        {
                            <button type="button" class="admin-link-danger"
                                    hx-post="@Url.Content($"~/admin/listings/{listing.Id}/unlist")"
                                    hx-target="#admin-listings-panel" hx-swap="outerHTML"
                                    hx-confirm="Take down @listing.Venue — @listing.Room? It disappears from search and its listing page 404s. The host can relist it themselves.">Unlist</button>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
