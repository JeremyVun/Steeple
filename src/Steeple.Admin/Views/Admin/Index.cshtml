@model Steeple.Admin.ViewModels.Admin.AdminWorkspaceViewModel
@{
    Layout = "_Layout";
    ViewData["Robots"] = "noindex,nofollow";
    var waiting = Model.ReviewQueue.PublishRequests.Count;
}

<section class="admin-page wrap">
    @await Html.PartialAsync("_AdminNav", Model)

    <div class="admin-kpis" aria-label="Admin metrics">
        @foreach (var metric in Model.Shell.Metrics)
        {
            <article class="admin-kpi admin-kpi-@metric.Tone">
                <p class="admin-kpi-label">@metric.Label</p>
                <p class="admin-kpi-value">@metric.Value</p>
                <p class="admin-kpi-detail">@metric.Detail</p>
            </article>
        }
    </div>

    <section class="admin-panel" aria-labelledby="admin-today-heading">
        <div class="admin-panel-header">
            <div>
                <p class="admin-eyebrow">Operations</p>
                <h2 id="admin-today-heading">What needs you</h2>
            </div>
            <a class="admin-link-button" href="~/admin/review">Open the review queue</a>
        </div>
        <p class="admin-hint">
            @if (waiting == 0)
            {
                <text>Nothing is waiting. Each newly claimed venue needs one listing decision; later rooms at that venue are self-serve.</text>
            }
            else
            {
                <text>@waiting first venue @(waiting == 1 ? "listing is" : "listings are") waiting for a decision. Approving one publishes it, verifies that venue, and makes its later rooms self-serve.</text>
            }
        </p>
    </section>
</section>
