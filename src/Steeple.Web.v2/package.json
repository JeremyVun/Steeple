{
  "name": "steeple-village",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:flat": "VITE_WORLD=off vite build --outDir dist-flat",
    "build:debug": "VITE_DEBUG=on vite build --outDir dist-debug",
    "build:flat:debug": "VITE_WORLD=off VITE_DEBUG=on vite build --outDir dist-flat-debug",
    "preview": "vite preview",
    "shot": "node tools/shot.mjs",
    "test": "node tools/store-test.mjs && node tools/notifications-test.mjs && node tools/flags-test.mjs && node tools/router-test.mjs && node tools/metadata-test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:a11y": "node tools/accessibility-test.mjs",
    "check": "npm test && npm run lint && npm run typecheck && npm run audit:prod && npm run test:a11y",
    "smoke:providers": "node tools/provider-smoke-test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "three": "^0.185.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "puppeteer": "^25.4.0",
    "typescript": "^7.0.2"
  }
}
