# Copy to a local deployment secret file; never commit real values.
POSTGRES_PASSWORD=replace-with-a-strong-password
AUTH_JWT_SIGNING_KEY=replace-with-openssl-rand-base64-48

# Sign-in. Apple is required; Google is optional but its mode must match its client ID.
APPLE_SERVICES_ID=com.example.steeple.web
APPLE_REDIRECT_URI=https://steeple.example/auth/apple/callback
GOOGLE_SSO_MODE=disabled
GOOGLE_CLIENT_ID=

# Pre-release may use disabled. Enabled requires both secret and site key.
TURNSTILE_MODE=disabled
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Real server-side geocoding: apple or google.
GEOCODING_MODE=google
GEOCODING_GOOGLE_API_KEY=
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=

MEDIA_SERVICE_URL=https://region.digitaloceanspaces.com
MEDIA_BUCKET=steeple-media
MEDIA_ACCESS_KEY=replace-me
MEDIA_SECRET_KEY=replace-me
MEDIA_PUBLIC_BASE_URL=https://steeple-media.region.cdn.digitaloceanspaces.com

SEO_PUBLIC_BASE_URL=https://steeple.example
EMAIL_API_KEY=replace-me
EMAIL_FROM=Steeple <hello@steeple.example>
EMAIL_WEB_BASE_URL=https://steeple.example

# Push is optional until mobile launch: disabled or fcm.
PUSH_MODE=disabled
PUSH_SERVICE_ACCOUNT_JSON=
PUSH_SERVICE_ACCOUNT_JSON_PATH=
